# system/.env — Host-level configuration for the pizero2-stack.
#
# HOW TO USE:
#   This file is generated automatically by prepare_firstboot.py from firstboot.conf.
#   On the Pi it lives at: /home/dietpi/pizero2-stack/system/.env
#   Read by: system/scripts/configure_firewall.sh, configure_ssh.sh, configure_fail2ban.sh,
#             configure_tailscale.sh (alongside docker/.env)
#
# To re-run a script manually on the Pi:
#   sudo bash system/scripts/configure_firewall.sh          # uses system/.env by default
#   sudo bash system/scripts/configure_ssh.sh
#   sudo bash system/scripts/configure_fail2ban.sh
#   sudo bash system/scripts/configure_tailscale.sh         # also reads docker/.env
#
# This file is gitignored — it contains secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── SSH (REQUIRED) ─────────────────────────────────────────────────────────────
# Non-standard port (1024–65535). Example: 2222, 8022, 51022.
SSH_PORT=

# ── Tailscale (OPTIONAL — enables automated provisioning) ─────────────────────
# Generate a reusable auth key at: https://login.tailscale.com/admin/settings/keys
# Rotate or delete this key after first provisioning.
TAILSCALE_AUTHKEY=

# ── Network (OPTIONAL — auto-detected from ip route if blank) ─────────────────
# LAN CIDR for SSH firewall rule. Set explicitly if auto-detection picks wrong interface.
# Example: 192.168.1.0/24
LAN_SUBNET=

# ── User (OPTIONAL) ────────────────────────────────────────────────────────────
DIETPI_USER=dietpi
