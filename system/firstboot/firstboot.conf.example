# firstboot.conf — Single config file for the pizero2-stack.
#
# HOW TO USE:
#   1. Copy this file: cp system/firstboot/firstboot.conf.example system/firstboot/firstboot.conf
#   2. Fill in your values below (every CHANGE_ME / REPLACE_WITH must be replaced).
#   3. Run: python3 system/firstboot/prepare_firstboot.py
#   4. Copy the four files from system/firstboot/out/ to the SD card boot partition.
#
# This file is gitignored — it contains secrets. Back it up securely.
# Never commit system/firstboot/firstboot.conf.

# ── Identity ──────────────────────────────────────────────────────────────────
HOSTNAME=pi-node
TZ=Europe/Rome
LOCALE=en_GB.UTF-8
KEYBOARD_LAYOUT=gb

# ── Credentials ───────────────────────────────────────────────────────────────
# Fallback password for root and dietpi accounts (used by DietPi first-boot only).
# configure_ssh.sh disables password SSH auth — this is only needed for console/recovery.
GLOBAL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Your workstation's SSH public key (cat ~/.ssh/id_ed25519.pub).
# Injected into ~/.ssh/authorized_keys for root and dietpi before SSH starts.
SSH_PUBKEY=REPLACE_WITH_YOUR_PUBLIC_KEY

# ── Network ───────────────────────────────────────────────────────────────────
# Static IP — leave STATIC_IP blank to use DHCP (recommended for zero-touch).
# With DHCP, SSH in via mDNS: ssh dietpi@<HOSTNAME>.local  (avahi pre-installed)
# or via Tailscale after first boot: ssh dietpi@<tailscale-ip>
STATIC_IP=
STATIC_MASK=255.255.255.0
STATIC_GATEWAY=192.168.1.1
STATIC_DNS=1.1.1.1

# ── Repo ──────────────────────────────────────────────────────────────────────
# URL cloned by Automation_Custom_Script.sh on first boot.
REPO_URL=https://github.com/<your-username>/pizero2-stack.git

# ── Stack ─────────────────────────────────────────────────────────────────────
# SSH port — required, no default. Choose a non-standard port (not 22).
SSH_PORT=CHANGE_ME_PORT

# Tailscale auth key — from https://login.tailscale.com/admin/settings/keys
# Enables fully automated provisioning. Rotate after first boot.
# Leave blank to authenticate manually: tailscale up
TAILSCALE_AUTHKEY=

# Ntfy admin password — hashed by prepare_firstboot.py → NTFY_ADMIN_HASH in docker.env.
# Username is fixed: ntfyadmin.
NTFY_ADMIN_PASSWORD=CHANGE_ME_PASSWORD

# Publisher password — hashed by prepare_firstboot.py → NTFY_PUBLISH_HASH in docker.env.
# Username is fixed: publisher. Used by scripts to send notifications.
# Generate: openssl rand -hex 24
NTFY_PUBLISH_PASSWORD=CHANGE_ME_16_CHARS_MIN

# ── Advanced (optional — defaults are fine for most setups) ───────────────────
# LAN subnet for SSH firewall rule. Auto-detected from routing table if blank.
LAN_SUBNET=

# Service ports. Change only if defaults conflict with existing services.
GATUS_PORT=8080
NTFY_PORT=2586

# Runtime data root for Docker volumes.
CONFIG_ROOT=/home/dietpi/docker/config

# DietPi user account. Almost always "dietpi".
DIETPI_USER=dietpi
