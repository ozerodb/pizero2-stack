# Gatus configuration — copy to ${CONFIG_ROOT}/gatus/config.yaml
# Full docs: https://github.com/TwinProduction/gatus

# ── Alerting ──────────────────────────────────────────────────────────────────
# Replace placeholders with your actual Tailscale hostname, Ntfy port, and
# publish password (NTFY_PUBLISH_PASSWORD from firstboot.conf).
alerting:
  ntfy:
    url: "http://ntfy:80"
    topic: "uptime"
    username: "ntfypub"
    password: "<NTFY_PUBLISH_PASSWORD>"
    default-alert:
      description: "health check failed"
      send-on-resolved: true
      failure-threshold: 3
      success-threshold: 2

# ── Endpoints ─────────────────────────────────────────────────────────────────
endpoints:
  - name: ntfy
    url: "http://ntfy:80"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
    alerts:
      - type: ntfy

  - name: internet (Cloudflare)
    url: "https://1.1.1.1"
    interval: 5m
    conditions:
      - "[STATUS] == 200"
    alerts:
      - type: ntfy

  - name: internet (Google)
    url: "https://www.google.com"
    interval: 5m
    conditions:
      - "[STATUS] == 200"
    alerts:
      - type: ntfy

# ── Additional endpoints (examples — uncomment and fill in) ───────────────────
