# docker/.env — Docker service configuration for the pizero2-stack.
#
# HOW TO USE:
#   This file is generated automatically by prepare_firstboot.py from firstboot.conf.
#   On the Pi it lives at: /home/dietpi/pizero2-stack/docker/.env
#   Read by: docker-compose (auto-discovered), system/scripts/configure_tailscale.sh (alongside system/.env)
#
# NEVER commit docker/.env — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── General (OPTIONAL) ────────────────────────────────────────────────────────
TZ=Europe/Rome
CONFIG_ROOT=/home/dietpi/docker/config

# ── Gatus (OPTIONAL) ──────────────────────────────────────────────────────────
# Go-based uptime monitor. Config lives at ${CONFIG_ROOT}/gatus/config.yaml.
# Copy docker/gatus.yaml.example → ${CONFIG_ROOT}/gatus/config.yaml and edit.
GATUS_PORT=8080

# ── Ntfy (OPTIONAL) ───────────────────────────────────────────────────────────
NTFY_PORT=2586

# Bcrypt hashes for the fixed ntfy users: ntfyadmin (admin) and ntfypub (user, write-only).
# DO NOT set these manually — generated by prepare_firstboot.py from NTFY_ADMIN_PASSWORD
# and NTFY_PUBLISH_PASSWORD in firstboot.conf.
NTFY_ADMIN_HASH=
NTFY_PUBLISH_HASH=

# Tailscale HTTPS URL for Ntfy (e.g. https://pi-node.your-tailnet.ts.net:2586).
# Used for notification click-through links. Set after first boot once you know
# your Tailscale hostname. Leave blank to skip (notifications still work).
NTFY_BASE_URL=

# Enable ntfy.sh upstream for Firebase/APNs push delivery (background notifications on mobile).
# Requires NTFY_BASE_URL to also be set. Leave blank to disable.
NTFY_UPSTREAM_BASE_URL=
